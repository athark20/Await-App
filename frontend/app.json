{
  "expo": {
    "name": "Await",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "await",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.awaitandroid.bbd4jg",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture screenshots and receipts to track commitments",
        "NSPhotoLibraryUsageDescription": "Pick screenshots to extract who owes you what",
        "NSMicrophoneUsageDescription": "Record voice notes to add Awaits hands-free"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07111F"
      },
      "package": "com.emergent.awaitandroid.bbd4jg",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "await" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "data": [{ "mimeType": "text/*" }],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND",
          "data": [{ "mimeType": "image/*" }],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND",
          "data": [
            { "mimeType": "application/pdf" },
            { "mimeType": "application/msword" },
            { "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
            { "mimeType": "text/csv" },
            { "mimeType": "application/vnd.ms-excel" },
            { "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
          ],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [{ "mimeType": "image/*" }, { "mimeType": "application/pdf" }, { "mimeType": "text/*" }],
          "category": ["DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07111F"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-audio",
        { "microphonePermission": "Record voice notes to add Awaits hands-free" }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick screenshots to extract who owes you what",
          "cameraPermission": "Capture screenshots and receipts to track commitments"
        }
      ],
      [
        "expo-notifications",
        { "color": "#168CFF" }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
